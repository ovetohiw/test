# Copy to .env for local overrides. Never commit real secrets.

YOOKASSA_SHOP_ID=CHANGE_ME
YOOKASSA_SECRET_KEY=CHANGE_ME

# Full stack: docker compose up --build -d  →  http://localhost:8080
